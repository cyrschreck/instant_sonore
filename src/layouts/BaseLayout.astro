---
import '../styles/global.css';

export interface Props {
  seo: {
    title: string;
    description: string;
    keywords?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    canonical?: string;
  };
  site: {
    name: string;
    domain: string;
  };
  jsonLd?: string; // bloc JSON-LD optionnel
  bodyClass?: string;
}

const { seo, site, jsonLd, bodyClass } = Astro.props;
const canonicalUrl = seo.canonical || `https://${site.domain}${Astro.url.pathname}`;
const ogImage = seo.ogImage || 'https://res.cloudinary.com/dhf3b3pyq/image/upload/v1777646098/mains_et_note_illumine%CC%81e_bb4vg8.png';
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
{seo.keywords && <meta name="keywords" content={seo.keywords} />}
<meta name="author" content="Carole Correvon" />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index, follow" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="fr_CH" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={seo.ogTitle || seo.title} />
<meta property="og:description" content={seo.ogDescription || seo.description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.ogTitle || seo.title} />
<meta name="twitter:description" content={seo.ogDescription || seo.description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0c1d31" />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230c1d31'/%3E%3Ctext x='50%25' y='54%25' text-anchor='middle' fill='%23b08945' font-family='serif' font-size='44' font-style='italic' font-weight='300'%3E%E2%9C%A6%3C/text%3E%3C/svg%3E" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://res.cloudinary.com" />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..900,0..100&family=Inter+Tight:wght@300;400;500;600&display=swap" rel="stylesheet" />

{jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
</head>
<body class={bodyClass}>

<slot />

<script>
// ── Reveal on scroll ──
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('is-visible'); });
}, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
document.querySelectorAll('section > *:not(.reveal)').forEach((el, i) => {
  el.classList.add('reveal');
  (el as HTMLElement).style.transitionDelay = (i * 60) + 'ms';
  revealObserver.observe(el);
});

// ── Nav scroll state ──
const nav = document.querySelector('.nav');
if (nav) {
  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}

// ── Scrollspy ──
const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-section-link');
const sectionIds = Array.from(navLinks).map(l => l.dataset.section).filter(Boolean) as string[];
const trackedSections = sectionIds.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];
const setActive = (id: string) => navLinks.forEach(link => link.classList.toggle('is-active', link.dataset.section === id));
if (trackedSections.length) {
  const spy = new IntersectionObserver((entries) => {
    const visible = entries.filter(e => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
    if (visible.length) setActive(visible[0].target.id);
  }, { rootMargin: '-25% 0px -65% 0px', threshold: 0 });
  trackedSections.forEach(s => spy.observe(s));
}

// ── Pro dropdown (index only) ──
const proMenu = document.getElementById('navProMenu');
const proTrigger = document.getElementById('navProTrigger');
if (proTrigger && proMenu) {
  proTrigger.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = !proMenu.classList.contains('is-open');
    proMenu.classList.toggle('is-open', open);
    proTrigger.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (!proMenu.contains(e.target as Node)) {
      proMenu.classList.remove('is-open');
      proTrigger.setAttribute('aria-expanded', 'false');
    }
  });
}

// ── Burger / overlay ──
const burger = document.getElementById('navBurger');
const overlay = document.getElementById('navOverlay');
if (burger && overlay) {
  const setMenuOpen = (open: boolean) => {
    burger.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    overlay.classList.toggle('is-open', open);
    overlay.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('menu-open', open);
  };
  burger.addEventListener('click', () => setMenuOpen(!burger.classList.contains('is-open')));
  overlay.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => { if (a.getAttribute('href')?.startsWith('#')) setMenuOpen(false); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (burger.classList.contains('is-open')) setMenuOpen(false);
      if (proMenu && proMenu.classList.contains('is-open')) { proMenu.classList.remove('is-open'); proTrigger?.setAttribute('aria-expanded', 'false'); }
    }
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 980 && burger.classList.contains('is-open')) setMenuOpen(false);
  });
}

// ── Smooth scroll offset ──
document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
  link.addEventListener('click', (e) => {
    const href = link.getAttribute('href');
    if (!href || href === '#' || href.length < 2) return;
    const target = document.querySelector(href);
    if (!target) return;
    e.preventDefault();
    const top = (target as HTMLElement).getBoundingClientRect().top + window.scrollY - 60;
    window.scrollTo({ top, behavior: 'smooth' });
  });
});

// ── AUDIO PLAYER (one active at a time) ──
(function(){
  const players = document.querySelectorAll<HTMLElement>('.player');
  const fmt = (s: number) => {
    if (!isFinite(s)) return '--:--';
    const m = Math.floor(s / 60), sec = Math.floor(s % 60);
    return `${m}:${sec.toString().padStart(2, '0')}`;
  };

  const pauseAll = (except: HTMLElement) => {
    players.forEach(p => {
      if (p === except) return;
      const a = (p as any).audio;
      if (a) a.pause();
      p.classList.remove('is-active', 'is-playing', 'is-loading');
    });
  };

  players.forEach(player => {
    const src = player.dataset.src;
    const btn = player.querySelector<HTMLButtonElement>('.player-btn');
    const head = player.querySelector<HTMLElement>('.player-head');
    const time = player.querySelector<HTMLElement>('.player-time');
    const bar = player.querySelector<HTMLElement>('.player-progress-bar');
    const seek = player.querySelector<HTMLButtonElement>('.player-seek');
    const progress = player.querySelector<HTMLElement>('.player-progress');
    let audio: HTMLAudioElement | null = null;

    const ensureAudio = () => {
      if (audio) return audio;
      audio = new Audio();
      audio.preload = 'metadata';
      if (src) audio.src = src;
      (player as any).audio = audio;
      audio.addEventListener('loadedmetadata', () => { if (time) time.textContent = fmt(audio!.duration); });
      audio.addEventListener('timeupdate', () => {
        if (audio!.duration && bar && time) {
          bar.style.width = (audio!.currentTime / audio!.duration * 100) + '%';
          time.textContent = fmt(audio!.duration - audio!.currentTime);
        }
      });
      audio.addEventListener('play', () => {
        player.classList.remove('is-loading');
        player.classList.add('is-active', 'is-playing');
      });
      audio.addEventListener('pause', () => { player.classList.remove('is-playing'); });
      audio.addEventListener('ended', () => {
        player.classList.remove('is-active', 'is-playing');
        if (bar) bar.style.width = '0%';
        if (time) time.textContent = fmt(audio!.duration);
      });
      audio.addEventListener('waiting', () => { player.classList.add('is-loading'); });
      audio.addEventListener('canplay', () => { player.classList.remove('is-loading'); });
      audio.addEventListener('error', () => {
        player.classList.remove('is-loading', 'is-playing');
        if (time) time.textContent = 'Indisp.';
      });
      return audio;
    };

    const togglePlay = () => {
      const a = ensureAudio();
      if (a.paused) {
        pauseAll(player);
        player.classList.add('is-active', 'is-loading');
        a.play().catch(() => { player.classList.remove('is-loading'); });
      } else {
        a.pause();
      }
    };

    btn?.addEventListener('click', (e) => { e.stopPropagation(); togglePlay(); });
    head?.addEventListener('click', togglePlay);

    seek?.addEventListener('click', (e) => {
      e.stopPropagation();
      const a = ensureAudio();
      if (!a.duration || !progress) return;
      const rect = progress.getBoundingClientRect();
      const x = (e as MouseEvent).clientX - rect.left;
      a.currentTime = (x / rect.width) * a.duration;
    });
  });
})();

// ── Contact form ──
const form = document.getElementById('contactForm') as HTMLFormElement | null;
if (form) {
  const status = form.querySelector('.form-status') as HTMLElement;
  const submit = form.querySelector('.form-submit') as HTMLButtonElement;
  const submitLabel = submit.querySelector('.form-submit-label') as HTMLElement;
  const originalLabel = submitLabel.textContent || '';
  const successMessage = form.dataset.successMessage || '✦ Merci, votre message est arrivé. Je vous réponds très vite, avec attention.';
  const siteEmail = form.dataset.siteEmail || 'carole@instantsonore.ch';
  const sitePhone = form.dataset.sitePhone || '076 404 32 82';
  const sitePhoneIntl = form.dataset.sitePhoneIntl || '+41764043282';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const botcheck = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
    if (botcheck && botcheck.checked) return;
    submit.disabled = true;
    submit.classList.add('is-loading');
    submitLabel.textContent = 'Envoi en cours…';
    status.className = 'form-status is-loading';
    status.textContent = '';
    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, { method: 'POST', body: formData, headers: { 'Accept': 'application/json' } });
      const data = await response.json().catch(() => ({}));
      if (response.ok && data.success !== false) {
        status.className = 'form-status is-success';
        status.innerHTML = successMessage;
        form.reset();
        setTimeout(() => status.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
      } else { throw new Error(data.message || 'Submission failed'); }
    } catch (err) {
      status.className = 'form-status is-error';
      status.innerHTML = `Une erreur est survenue. Vous pouvez m'écrire à <a href="mailto:${siteEmail}">${siteEmail}</a> ou m'appeler au <a href="tel:${sitePhoneIntl}">${sitePhone}</a>.`;
    } finally {
      submit.disabled = false;
      submit.classList.remove('is-loading');
      submitLabel.textContent = originalLabel;
    }
  });
}
</script>

</body>
</html>
