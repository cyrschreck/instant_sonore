---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Charger le contenu
const siteEntry = await getEntry('settings', 'site');
const site = siteEntry!.data;

const homeEntry = await getEntry('pages', 'home');
const home = homeEntry!.data as any;

const page = (await getEntry('pages', 'ecouter'))!.data as any;
const allSongs = await getCollection('songs');
const songCount = (category: string) => allSongs.filter(s => s.data.category === category).length;

// JSON-LD
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": `https://${site.domain}/#business`,
      "name": site.name,
      "description": "Création de chansons personnalisées sur mesure pour les moments essentiels de la vie : hommages, transitions, célébrations.",
      "url": `https://${site.domain}/`,
      "image": `https://${site.domain}/uploads/og/og-accueil.jpg`,
      "telephone": site.phoneIntl,
      "email": site.email,
      "priceRange": "CHF 350 – Sur devis",
      "founder": { "@id": `https://${site.domain}/#carole` },
      "address": { "@type": "PostalAddress", "addressLocality": "Echallens", "addressRegion": "Vaud", "postalCode": "1040", "addressCountry": "CH" },
      "geo": { "@type": "GeoCoordinates", "latitude": 46.6413, "longitude": 6.6328 },
      "areaServed": ["Vaud", "Fribourg", "Genève", "Neuchâtel", "Valais", "Jura"].map(name => ({ "@type": "AdministrativeArea", "name": name })),
      "sameAs": [site.facebook, site.instagram].filter(Boolean),
      "subjectOf": home.presse ? {
        "@type": "NewsArticle",
        "headline": home.presse.headline.replace(/[«»]/g, '').trim(),
        "publisher": { "@type": "Organization", "name": home.presse.source },
        "datePublished": "2026-08-07",
        ...(home.presse.link ? { "url": home.presse.link } : {})
      } : undefined,
      "inLanguage": "fr-CH"
    },
    {
      "@type": "Person",
      "@id": `https://${site.domain}/#carole`,
      "name": "Carole Correvon",
      "jobTitle": "Auteure de chansons personnalisées, thérapeute facilitatrice de changement",
      "description": "Infirmière de première formation et thérapeute, fondatrice d'Instant Sonore à Echallens (VD).",
      "image": home.carole.photo ? `https://${site.domain}${home.carole.photo}` : undefined,
      "worksFor": { "@id": `https://${site.domain}/#business` },
      "address": { "@type": "PostalAddress", "addressLocality": "Echallens", "addressCountry": "CH" }
    },
    {
      "@type": "Service",
      "name": "Chanson personnalisée sur mesure",
      "provider": { "@id": `https://${site.domain}/#business` },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Formules Instant Sonore",
        "itemListElement": home.tarifs.formules.map((f: any) => ({
          "@type": "Offer",
          "name": f.name.replace(/<[^>]+>/g, '') + ' — ' + f.context,
          "price": (f.price.match(/\d+/) || ['0'])[0],
          "priceCurrency": "CHF"
        }))
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": home.faq.items.map((item: any) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answerHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()
        }
      }))
    }
  ]
});
---
<BaseLayout seo={home.seo} site={site} jsonLd={jsonLd}>

<SiteNav site={site} />

<!-- ─── HERO ─────────────────────────────────────────── -->
<header class="hero">
  <div class="hero-image"><img src={home.hero.image} alt="" loading="eager" /></div>
  <div class="hero-inner">
    <h1><span class="hero-eyebrow">{home.hero.eyebrow}</span> <span class="hero-title" set:html={home.hero.title}></span></h1>
    <p class="hero-tagline">{home.hero.tagline}</p>
    <p class="hero-sub">{home.hero.sub}</p>
    <div class="hero-actions">
      <a href={home.hero.ctaPrimary.href} class="btn btn-primary">{home.hero.ctaPrimary.label} <span class="btn-arrow">→</span></a>
      <a href={home.hero.ctaGhost.href} class="btn btn-ghost">{home.hero.ctaGhost.label}</a>
    </div>
  </div>
</header>

<!-- ─── CONCEPT ──────────────────────────────────────── -->
<section class="concept">
  <div class="container-narrow">
    <span class="eyebrow" style="margin-bottom:2rem;display:inline-block">— ✦ —</span>
    <p class="concept-lead" set:html={home.concept.lead}></p>
    <p class="concept-body">{home.concept.body}</p>
    <div class="concept-image">
      <img src={home.concept.image} alt={home.concept.imageAlt} loading="lazy" />
    </div>
  </div>
</section>

<!-- ─── ORIGINE ──────────────────────────────────────── -->
<section class="origine" id="origine">
  <div class="origine-grid">
    <aside class="origine-side">
      <span class="eyebrow">{home.origine.eyebrow}</span>
      <h2 set:html={home.origine.title}></h2>
      <p class="origine-quote">{home.origine.quote}</p>
      <div class="origine-side-image">
        <img src={home.origine.image} alt={home.origine.imageAlt} loading="lazy" />
      </div>
    </aside>
    <div class="origine-text">
      {home.origine.paragraphs.map((p: string) => (
        <p set:html={p}></p>
      ))}
      <div class="pull-quote">
        <span>✦</span>
        {home.origine.pullQuote}
      </div>
      <p set:html={home.origine.outro}></p>
      {home.origine.thanks && (
        <p style="font-style:italic;color:var(--gold);font-family:'Fraunces',serif;font-variation-settings:'opsz' 24,'SOFT' 100">{home.origine.thanks}</p>
      )}
    </div>
  </div>
</section>

<!-- ─── PILIERS / MOMENTS ────────────────────────────── -->
<section class="piliers" id="moments">
  <div class="piliers-head">
    <span class="eyebrow">{home.piliers.eyebrow}</span>
    <h2 set:html={home.piliers.title}></h2>
    <p>{home.piliers.subtitle}</p>
  </div>
  <div class="piliers-grid">
    {home.piliers.items.map((item: any) => (
      <article class="pilier">
        <div class="pilier-image">
          <img src={item.image} alt={item.imageAlt} loading="lazy" />
          <div class="pilier-num">— ✦ {item.num} —</div>
        </div>
        <div class="pilier-content">
          <h3>{item.title}</h3>
          <div class="pilier-sub">{item.sub}</div>
          <p>{item.description}</p>
          <ul class="pilier-list">
            {item.tags.map((tag: string) => <li>{tag}</li>)}
          </ul>
          {item.cta && (
            <a href={item.cta.href} class="pilier-cta">{item.cta.label} <span aria-hidden="true">→</span></a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<!-- ─── ÉCOUTER ──────────────────────────────────────── -->
<section class="ecouter" id="ecouter">
  <div class="ecouter-head">
    <span class="eyebrow">{home.ecouter.eyebrow}</span>
    <p class="ecouter-lead">{home.ecouter.lead}</p>
    <h2 set:html={home.ecouter.title}></h2>
    <p>{home.ecouter.subtitle}</p>
  </div>
  <div class="ecouter-univers">
    {page.univers.map((u: any) => (
      <a href={`/ecouter/${u.id}`} class="ecouter-univers-card">
        <span class="ecouter-univers-num">— ✦ {u.num} —</span>
        <span class="ecouter-univers-title">{u.title}</span>
        <span class="ecouter-univers-sub">{u.sub}</span>
        <span class="ecouter-univers-count">{songCount(u.category)} chansons à écouter →</span>
      </a>
    ))}
  </div>
  <div class="ecouter-all">
    <a href="/ecouter" class="btn btn-primary">Toutes les créations <span class="btn-arrow">→</span></a>
  </div>
  {home.ecouter.note && <p class="ecouter-note">{home.ecouter.note}</p>}
</section>

<!-- ─── PROCESSUS ────────────────────────────────────── -->
<section class="processus" id="processus">
  <img class="processus-decor" src={home.processus.decorImage || '/uploads/web/livre-ecouteur.webp'} alt="" loading="lazy" />
  <div class="processus-head">
    <span class="eyebrow">{home.processus.eyebrow}</span>
    <h2 set:html={home.processus.title}></h2>
  </div>
  <div class="steps">
    {home.processus.steps.map((step: any) => (
      <div class="step">
        <div class="step-num">{step.num}</div>
        <div class="step-body">
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ─── CAROLE ───────────────────────────────────────── -->
<section class="carole" id="carole">
  <div class="carole-grid">
    <div>
      <div class="portrait-frame">
        <div class="portrait-inner">
          {home.carole.photo ? (
            <img src={home.carole.photo} alt="Carole Correvon" />
          ) : (
            <span class="portrait-placeholder">✦<br/>Photo<br/>Carole</span>
          )}
        </div>
      </div>
      <p class="portrait-caption">{home.carole.photoCaption}</p>
    </div>
    <div class="carole-text">
      <span class="eyebrow">{home.carole.eyebrow}</span>
      <h2 set:html={home.carole.title}></h2>
      {home.carole.paragraphs.map((p: string) => <p set:html={p}></p>)}
      <div class="carole-signature">— {home.carole.signature}</div>
    </div>
  </div>
</section>

<!-- ─── PRESSE ───────────────────────────────────────── -->
{home.presse && (
<section class="presse" id="presse">
  <div class="presse-grid">
    <a class="presse-image" href={home.presse.link || home.presse.image} target="_blank" rel="noopener" aria-label="Ouvrir l'article en grand">
      <img src={home.presse.image} alt={home.presse.imageAlt} loading="lazy" />
    </a>
    <div class="presse-text">
      <span class="eyebrow">{home.presse.eyebrow}</span>
      <h2 set:html={home.presse.title}></h2>
      <p class="presse-source">{home.presse.source} · {home.presse.date}</p>
      <p class="presse-headline">{home.presse.headline}</p>
      <p>{home.presse.text}</p>
      <a class="presse-link" href={home.presse.link || home.presse.image} target="_blank" rel="noopener">Lire l'article →</a>
    </div>
  </div>
</section>
)}

<!-- ─── TARIFS ───────────────────────────────────────── -->
<section class="tarifs" id="tarifs">
  <div class="tarifs-head">
    <span class="eyebrow">{home.tarifs.eyebrow}</span>
    <h2 set:html={home.tarifs.title}></h2>
    <p>{home.tarifs.subtitle}</p>
  </div>
  <p class="tarifs-intro" set:html={home.tarifs.intro}></p>
  <div class="formules">
    {home.tarifs.formules.map((f: any) => (
      <div class={`formule${f.featured ? ' formule-featured' : ''}`}>
        {f.tag && <div class="formule-tag">{f.tag}</div>}
        <div class="formule-name" set:html={f.name}></div>
        <div class="formule-context">{f.context}</div>
        <div class="formule-price">{f.price}{f.priceUnit && <small> {f.priceUnit}</small>}</div>
        <div class="formule-divider"></div>
        <ul class="formule-includes">
          {f.includes.map((i: string) => <li>{i}</li>)}
        </ul>
        <a href={f.cta.href} class="formule-cta">{f.cta.label} →</a>
      </div>
    ))}
  </div>
  <p class="tarifs-foot">{home.tarifs.foot}</p>
</section>

<!-- ─── PROS GATEWAY ─────────────────────────────────── -->
<section class="pros-gw">
  <div class="pros-gw-head">
    <span class="eyebrow">{home.prosGateway.eyebrow}</span>
    <h2 set:html={home.prosGateway.title}></h2>
    <p>{home.prosGateway.subtitle}</p>
  </div>
  <div class="pros-cards">
    {home.prosGateway.cards.map((card: any) => (
      <a href={card.href} class="pros-card">
        <div class="pros-card-image">
          <img src={card.image} alt={card.imageAlt} loading="lazy" />
        </div>
        <div class="pros-card-body">
          <span class="pros-card-tag">{card.tag}</span>
          <h3 set:html={card.title}></h3>
          <p>{card.description}</p>
          <span class="pros-card-arrow">Découvrir →</span>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- ─── FAQ ──────────────────────────────────────────── -->
<section class="faq" id="faq">
  <div class="faq-head">
    <span class="eyebrow">{home.faq.eyebrow}</span>
    <h2 set:html={home.faq.title}></h2>
    <p>{home.faq.subtitle}</p>
  </div>
  <div class="faq-list">
    {home.faq.items.map((item: any) => (
      <details class="faq-item">
        <summary><span>{item.question}</span><span class="faq-toggle" aria-hidden="true">+</span></summary>
        <div class="faq-answer" set:html={item.answerHtml}></div>
      </details>
    ))}
  </div>
</section>

<!-- ─── TÉMOIGNAGE ───────────────────────────────────── -->
<section class="temoignage">
  <div class="container-narrow">
    <p class="temoignage-quote">{home.temoignage.quote}</p>
    <p class="temoignage-attr">{home.temoignage.attribution}</p>
  </div>
</section>

<!-- ─── CONTACT ──────────────────────────────────────── -->
<section class="contact" id="contact">
  <div class="contact-inner">
    <span class="eyebrow">{home.contact.eyebrow}</span>
    <h2 set:html={home.contact.title}></h2>
    <p class="contact-lead">{home.contact.lead}</p>

    <form class="contact-form" id="contactForm" name="contact-accueil" action="/" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate
          data-success-message={home.contact.successMessage}
          data-site-email={site.email}
          data-site-phone={site.phone}
          data-site-phone-intl={site.phoneIntl}>
      <input type="hidden" name="form-name" value="contact-accueil" />
      <input type="hidden" name="subject" value={`Nouveau message depuis ${site.domain}`} />
      <input type="text" name="bot-field" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="form-grid">
        <div class="form-field">
          <label for="cf-name">Prénom & nom <span class="form-required" aria-hidden="true">*</span></label>
          <input type="text" id="cf-name" name="name" required autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="cf-email">Email <span class="form-required" aria-hidden="true">*</span></label>
          <input type="email" id="cf-email" name="email" required autocomplete="email" />
        </div>
        <div class="form-field">
          <label for="cf-phone">Téléphone <span class="form-optional">(optionnel)</span></label>
          <input type="tel" id="cf-phone" name="phone" autocomplete="tel" />
        </div>
        <div class="form-field">
          <label for="cf-moment">Quel moment ?</label>
          <select id="cf-moment" name="moment">
            <option value="">Choisir…</option>
            <option>Célébration · mariage, naissance, anniversaire</option>
            <option>Transition · retraite, mots non-dits, réconciliation</option>
            <option>Hommage · deuil, fin de vie, héritage sonore</option>
            <option>Je ne sais pas encore</option>
          </select>
        </div>
      </div>
      <div class="form-field form-field-full">
        <label for="cf-message">Votre message <span class="form-required" aria-hidden="true">*</span></label>
        <textarea id="cf-message" name="message" rows="5" required placeholder="Quelques mots sur votre intention, le moment à honorer, ce que vous portez…"></textarea>
      </div>
      <button type="submit" class="form-submit">
        <span class="form-submit-label">{home.contact.submitLabel}</span>
        <span class="form-submit-icon" aria-hidden="true">→</span>
      </button>
      <div class="form-status" role="status" aria-live="polite"></div>
      <p class="form-privacy">{home.contact.privacy}</p>
    </form>

    <div class="contact-divider"><span>ou directement</span></div>
    <div class="contact-info">
      <a href={`tel:${site.phoneIntl}`}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <div class="contact-info-sub">{site.location}</div>
    </div>
  </div>
</section>

<!-- ─── FOOTER ───────────────────────────────────────── -->
<SiteFooter site={site} />

</BaseLayout>
